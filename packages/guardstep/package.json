{
  "name": "guardstep",
  "version": "0.1.0-alpha.1",
  "description": "Compiler, local runtime, and CLI for GuardStep workflows",
  "type": "module",
  "private": true,
  "bin": {
    "guardstep": "./dist/cli/main.js",
    "gs": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./codegen": "./dist/codegen/index.js",
    "./compiler": "./dist/compiler/index.js",
    "./providers": "./dist/providers/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./ir": "./dist/ir/index.js",
    "./testing": "./dist/testing/index.js"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
