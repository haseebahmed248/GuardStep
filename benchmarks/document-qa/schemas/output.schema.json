{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardstep:benchmark:document-qa:output:1",
  "title": "Document Q&A answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "text", "citations"],
  "properties": {
    "status": {
      "enum": ["answered", "insufficient_context"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "url"],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
