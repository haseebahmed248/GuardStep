{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardstep:benchmark:document-qa:event:1",
  "title": "Document Q&A portable event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "run_id", "type", "data"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "run.started",
        "capability.checked",
        "tool.started",
        "tool.succeeded",
        "tool.failed",
        "model.started",
        "model.succeeded",
        "model.failed",
        "assertion.failed",
        "budget.exceeded",
        "run.succeeded",
        "run.failed"
      ]
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  }
}
