{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardstep:benchmark:support-approval:resume:1",
  "title": "Authenticated support approval decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "approval_id",
    "step_id",
    "plan_digest",
    "outcome",
    "approver"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "approval_id": { "type": "string", "minLength": 1 },
    "step_id": { "const": "approval:disable-mfa" },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": { "enum": ["approved", "denied"] },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "roles"],
      "properties": {
        "user_id": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "workspace_owner" },
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
